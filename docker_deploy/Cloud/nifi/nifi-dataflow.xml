<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<flow version="3">
  <settings>
    <setting name="flowFileRepository">./flowfile_repository</setting>
    <setting name="contentRepository">./content_repository</setting>
    <setting name="databaseRepository">./database_repository</setting>
  </settings>

  <!-- ============================
       PROCESSOR 1: Consume from Kafka
       ============================= -->
  <processor>
    <id>ConsumeKafka_1</id>
    <name>📥 ConsumeKafka (ev_raw)</name>
    <type>org.apache.nifi.kafka.processors.ConsumeKafka_0_10</type>
    <position>100, 100</position>
    <config>
      <property name="bootstrap.servers">kafka:9092</property>
      <property name="topics">ev_raw</property>
      <property name="group.id">nifi-battery-consumer</property>
      <property name="auto.offset.reset">earliest</property>
      <property name="max.poll.records">100</property>
      <property name="session.timeout.ms">30000</property>
    </config>
    <relationships>
      <relationship name="success">LogAttribute_1</relationship>
      <relationship name="parse.failure">LogError_1</relationship>
    </relationships>
  </processor>

  <!-- ============================
       PROCESSOR 2: Log Incoming Messages
       ============================= -->
  <processor>
    <id>LogAttribute_1</id>
    <name>📋 LogAttribute (Debug)</name>
    <type>org.apache.nifi.processors.standard.LogAttribute</type>
    <position>300, 100</position>
    <config>
      <property name="Log Level">INFO</property>
      <property name="Log Payload">true</property>
      <property name="Attributes to Log">key,value</property>
    </config>
    <relationships>
      <relationship name="success">JoltTransformJSON_1</relationship>
    </relationships>
  </processor>

  <!-- ============================
       PROCESSOR 3: Transform/Parse JSON
       ============================= -->
  <processor>
    <id>JoltTransformJSON_1</id>
    <name>🔄 JoltTransformJSON (Enrich)</name>
    <type>org.apache.nifi.processors.standard.JoltTransformJSON</type>
    <position>500, 100</position>
    <config>
      <property name="Jolt Specification">{
  "operation": "default",
  "spec": {
    "processed_at": "${now()}",
    "source": "nifi",
    "status": "transformed"
  }
}</property>
      <property name="Pretty Print JSON">true</property>
    </config>
    <relationships>
      <relationship name="success">EvaluateJsonPath_1</relationship>
      <relationship name="failure">LogError_2</relationship>
    </relationships>
  </processor>

  <!-- ============================
       PROCESSOR 4: Extract JSON Fields
       ============================= -->
  <processor>
    <id>EvaluateJsonPath_1</id>
    <name>📊 EvaluateJsonPath (Extract)</name>
    <type>org.apache.nifi.processors.standard.EvaluateJsonPath</type>
    <position>700, 100</position>
    <config>
      <property name="Destination">flowfile-attribute</property>
      <property name="Return Type">auto</property>
      <property name="voltage">$.voltage</property>
      <property name="temperature">$.temperature</property>
      <property name="soc">$.soc</property>
      <property name="soh">$.soh</property>
      <property name="timestamp">$.timestamp</property>
    </config>
    <relationships>
      <relationship name="match">SplitJson_1</relationship>
      <relationship name="unmatched">LogError_3</relationship>
    </relationships>
  </processor>

  <!-- ============================
       PROCESSOR 5: Split JSON (batch processing)
       ============================= -->
  <processor>
    <id>SplitJson_1</id>
    <name>✂️ SplitJson (Batch)</name>
    <type>org.apache.nifi.processors.standard.SplitJson</type>
    <position>900, 100</position>
    <config>
      <property name="JsonPath Expression">$.*</property>
    </config>
    <relationships>
      <relationship name="success">PutSQL_PostgreSQL</relationship>
    </relationships>
  </processor>

  <!-- ============================
       PROCESSOR 6: Write to PostgreSQL Database
       ============================= -->
  <processor>
    <id>PutSQL_PostgreSQL</id>
    <name>💾 PutSQL (PostgreSQL)</name>
    <type>org.apache.nifi.processors.standard.PutSQL</type>
    <position>100, 300</position>
    <config>
      <property name="Database Connection Pooling Service">PostgreSQL_Connection_Pool</property>
      <property name="SQL Statement">INSERT INTO battery_metrics 
        (voltage, temperature, current, soc, soh, timestamp) 
        VALUES (?, ?, ?, ?, ?, NOW())
        ON CONFLICT DO NOTHING</property>
      <property name="Translate Database-Specific Datatypes">true</property>
    </config>
    <relationships>
      <relationship name="success">PublishKafka_Processed</relationship>
      <relationship name="failure">LogError_4</relationship>
      <relationship name="retry">PutSQL_PostgreSQL</relationship>
    </relationships>
  </processor>

  <!-- ============================
       PROCESSOR 7: Publish to Kafka (processed data)
       ============================= -->
  <processor>
    <id>PublishKafka_Processed</id>
    <name>📤 PublishKafka (ev_processed)</name>
    <type>org.apache.nifi.kafka.processors.PublishKafka_0_10</type>
    <position>300, 300</position>
    <config>
      <property name="bootstrap.servers">kafka:9092</property>
      <property name="topic">ev_processed</property>
      <property name="key.attribute.encoding">utf-8</property>
      <property name="message.demarcator">\n</property>
      <property name="Compression Type">snappy</property>
    </config>
    <relationships>
      <relationship name="success">LogSuccess</relationship>
      <relationship name="failure">LogError_5</relationship>
    </relationships>
  </processor>

  <!-- ============================
       PROCESSOR 8: Anomaly Detection (Branching)
       ============================= -->
  <processor>
    <id>RouteonAttribute_Anomaly</id>
    <name>⚠️ RouteOnAttribute (Anomaly Check)</name>
    <type>org.apache.nifi.processors.standard.RouteOnAttribute</type>
    <position>500, 300</position>
    <config>
      <property name="voltage_high">${voltage:gt(4.2)}</property>
      <property name="temperature_high">${temperature:gt(50)}</property>
      <property name="soc_low">${soc:lt(20)}</property>
      <property name="soh_critical">${soh:lt(50)}</property>
    </config>
    <relationships>
      <relationship name="voltage_high">PublishKafka_Alerts</relationship>
      <relationship name="temperature_high">PublishKafka_Alerts</relationship>
      <relationship name="soc_low">PublishKafka_Alerts</relationship>
      <relationship name="soh_critical">PublishKafka_Alerts</relationship>
      <relationship name="unmatched">LogSuccess</relationship>
    </relationships>
  </processor>

  <!-- ============================
       PROCESSOR 9: Publish Alerts to Kafka
       ============================= -->
  <processor>
    <id>PublishKafka_Alerts</id>
    <name>🚨 PublishKafka (ev_alerts)</name>
    <type>org.apache.nifi.kafka.processors.PublishKafka_0_10</type>
    <position>700, 300</position>
    <config>
      <property name="bootstrap.servers">kafka:9092</property>
      <property name="topic">ev_alerts</property>
      <property name="key.attribute.encoding">utf-8</property>
    </config>
    <relationships>
      <relationship name="success">LogAlerts</relationship>
      <relationship name="failure">LogError_6</relationship>
    </relationships>
  </processor>

  <!-- ============================
       PROCESSOR 10: Success Logging
       ============================= -->
  <processor>
    <id>LogSuccess</id>
    <name>✅ LogAttribute (Success)</name>
    <type>org.apache.nifi.processors.standard.LogAttribute</type>
    <position>500, 500</position>
    <config>
      <property name="Log Level">INFO</property>
      <property name="Log Payload">false</property>
      <property name="Prefix">SUCCESS</property>
    </config>
    <relationships>
      <relationship name="success">drop-success</relationship>
    </relationships>
  </processor>

  <!-- ============================
       PROCESSOR 11: Alert Logging
       ============================= -->
  <processor>
    <id>LogAlerts</id>
    <name>⚠️ LogAttribute (Alerts)</name>
    <type>org.apache.nifi.processors.standard.LogAttribute</type>
    <position>700, 500</position>
    <config>
      <property name="Log Level">WARN</property>
      <property name="Log Payload">true</property>
      <property name="Prefix">ALERT_DETECTED</property>
    </config>
    <relationships>
      <relationship name="success">drop-alert</relationship>
    </relationships>
  </processor>

  <!-- ============================
       ERROR HANDLERS
       ============================= -->
  <processor>
    <id>LogError_1</id>
    <name>❌ LogAttribute (Error-Parse)</name>
    <type>org.apache.nifi.processors.standard.LogAttribute</type>
    <position>100, 650</position>
    <config>
      <property name="Log Level">ERROR</property>
      <property name="Log Payload">true</property>
      <property name="Prefix">ERROR_PARSE</property>
    </config>
  </processor>

  <processor>
    <id>LogError_2</id>
    <name>❌ LogAttribute (Error-Transform)</name>
    <type>org.apache.nifi.processors.standard.LogAttribute</type>
    <position>300, 650</position>
    <config>
      <property name="Log Level">ERROR</property>
      <property name="Log Payload">true</property>
      <property name="Prefix">ERROR_TRANSFORM</property>
    </config>
  </processor>

  <!-- Connection definitions -->
  <connection>
    <source id="ConsumeKafka_1" rel="success"/>
    <destination id="LogAttribute_1"/>
  </connection>

  <connection>
    <source id="LogAttribute_1" rel="success"/>
    <destination id="JoltTransformJSON_1"/>
  </connection>

  <connection>
    <source id="JoltTransformJSON_1" rel="success"/>
    <destination id="EvaluateJsonPath_1"/>
  </connection>

  <connection>
    <source id="EvaluateJsonPath_1" rel="match"/>
    <destination id="RouteonAttribute_Anomaly"/>
  </connection>

  <connection>
    <source id="RouteonAttribute_Anomaly" rel="voltage_high,temperature_high,soc_low,soh_critical"/>
    <destination id="PublishKafka_Alerts"/>
  </connection>

  <connection>
    <source id="PublishKafka_Alerts" rel="success"/>
    <destination id="LogAlerts"/>
  </connection>

  <connection>
    <source id="RouteonAttribute_Anomaly" rel="unmatched"/>
    <destination id="PutSQL_PostgreSQL"/>
  </connection>

  <connection>
    <source id="PutSQL_PostgreSQL" rel="success"/>
    <destination id="LogSuccess"/>
  </connection>
</flow>